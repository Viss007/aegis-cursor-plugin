{
  "version": 1,
  "hooks": {
    "afterAgentResponse": [
      {
        "command": "python ./hooks/no_fake_done.py",
        "timeout": 8
      }
    ],
    "preToolUse": [
      {
        "command": "python ./hooks/freeze_gate.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python ./hooks/freeze_clear.py",
        "timeout": 5
      }
    ]
  }
}
